PORT=5000
NODE_ENV=development

# Database configuration (SQLite default for zero-setup, swappable to PostgreSQL)
DATABASE_URL="file:./dev.db"

# Redis Configuration (BullMQ & Rate Limiter)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_URL=redis://localhost:6379

# Queue & Worker Settings
WORKER_CONCURRENCY=5
MAX_EMAILS_PER_HOUR=60
MIN_DELAY_BETWEEN_EMAILS_MS=2000

# Ethereal SMTP Settings (Leave blank to auto-generate on first run!)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Sender Identity
DEFAULT_SENDER=scheduler@reachinbox-demo.com

# Auth
JWT_SECRET=reachinbox_super_secret_jwt_key_2026
